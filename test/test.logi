module auth_demo

  failure validation_failed
    field: text?
    message: text
  end

  usecase submit_login for email: text, password: text returns void
    check email is not empty, otherwise fail with validation_failed with field "email" and message "Enter your email address"
    check email is in a valid email format, otherwise fail with validation_failed with field "email" and message "Enter a valid email address"
    check password is not empty, otherwise fail with validation_failed with field "password" and message "Enter your password"
    step show alert "calling backend"
    return
  end

  @test_id("login_form")
  @render("strict")
  @variant("immersive")
  @motion("standard")

  widget login_form
    prop email: text
    prop password: text
    prop validation_field: text?
    prop validation_message: text?
    prop is_loading: boolean

    event email_changed(value: text)
    event password_changed(value: text)
    event submit_clicked()

    show badge brand_badge label "LX"
    show text title label "Welcome back"
    show text subtitle label "Sign in to continue to your workspace"

    show input email_field label "Email address"
    when validation_field is "email"
      show error_text email_error_text label validation_message
    end

    show password_input password_field label "Password"
    when validation_field is "password"
      show error_text password_error_text label validation_message
    end

    when is_loading
      show spinner submit_spinner
    end

    show button submit_button label "Continue"
    show helper_text helper_note label "Use any password. The demo only validates the form."
  end

  @route("/login")
  @render("strict")
  @layout("centered_form")
  @theme("dark")

  screen login_screen
    state email: text
    state password: text
    state validation_field: text?
    state validation_message: text?
    state is_loading: boolean = false

    action submit_login_action -> call submit_login with email, password

    show login_form with email: email, password: password, validation_field: validation_field, validation_message: validation_message, is_loading: is_loading and variant immersive

    on login_form.email_changed -> set email
    on login_form.email_changed -> set validation_field = null
    on login_form.email_changed -> set validation_message = null

    on login_form.password_changed -> set password
    on login_form.password_changed -> set validation_field = null
    on login_form.password_changed -> set validation_message = null

    on login_form.submit_clicked -> set validation_field = null
    on login_form.submit_clicked -> set validation_message = null
    on login_form.submit_clicked -> run submit_login_action

    on submit_login_action.started -> set is_loading = true
    on submit_login_action.failed -> set is_loading = false
    on submit_login_action.failed -> set validation_field = submit_login_action.error.field
    on submit_login_action.failed -> set validation_message = submit_login_action.error.message
    on submit_login_action.succeeded -> set is_loading = false
  end

  flow auth_flow
    start: login_screen
  end

end
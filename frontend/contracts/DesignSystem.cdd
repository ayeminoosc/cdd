/**
 * Global Design System.
 * 
 * THEME: Minimalist Monochrome.
 * 
 * COLORS:
 * - Background: #FFFFFF (White)
 * - Surface: #F4F4F5 (Light Gray)
 * - Primary: #000000 (Black)
 * - Text Primary: #18181B (Zinc 900)
 * - Text Secondary: #71717A (Zinc 500)
 * - Border: #E4E4E7 (Zinc 200)
 * 
 * TYPOGRAPHY:
 * - Font: Inter (sans-serif)
 * - Headings: Bold, Tracking-tight
 * 
 * SHAPES:
 * - Radius: 0px (Sharp, Brutalist) OR 4px (Minimal)
 * - Shadows: None or very subtle border-bottom.
 * 
 * COMPONENTS:
 * - Buttons: Black background, White text, no border radius (Sharp).
 * - Inputs: White background, Black border (2px) on focus.
 */
data DesignSystem {
  mode: string // "light" | "dark"
}

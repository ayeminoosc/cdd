{
  "name": "logi",
  "displayName": "Logi Language Support",
  "description": "Syntax highlighting and formatting for Logi and LogiD languages",
  "version": "0.1.1",
  "publisher": "logi",
  "icon": "icons/logi-extension.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/logi-lang/logi-vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "logi",
    "logid",
    "intent language",
    "dsl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "logi",
        "aliases": ["Logi", "logi"],
        "extensions": [".logi"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/logi-light.png",
          "dark": "./icons/logi-dark.png"
        }
      },
      {
        "id": "logid",
        "aliases": ["LogiD", "logid"],
        "extensions": [".logid"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/logid-light.png",
          "dark": "./icons/logid-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "logi",
        "scopeName": "source.logi",
        "path": "./syntaxes/logi.tmLanguage.json"
      },
      {
        "language": "logid",
        "scopeName": "source.logid",
        "path": "./syntaxes/logid.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "logi.format",
        "title": "Format Document",
        "category": "Logi"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Logi",
      "properties": {
        "logi.formatting.indentSize": {
          "type": "number",
          "default": 2,
          "description": "Number of spaces for indentation"
        },
        "logi.formatting.alignColons": {
          "type": "boolean",
          "default": true,
          "description": "Align colons in token definitions"
        },
        "logi.formatting.blankLinesBetweenBlocks": {
          "type": "boolean",
          "default": true,
          "description": "Add blank lines between top-level blocks"
        }
      }
    }
  },
  "scripts": {
    "generate:icons": "node ./scripts/generate-icons.mjs",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.19.0",
    "eslint": "^8.45.0",
    "typescript": "^5.1.6"
  }
}

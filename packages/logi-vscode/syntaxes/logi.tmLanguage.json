{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Logi",
  "scopeName": "source.logi",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#references"
    },
    {
      "include": "#qualified-names"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#built-in-types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.logi",
          "match": "#.*$"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.logi",
          "match": "@([a-z_][a-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.tag.logi"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.logi",
          "match": "\\b(module|type|extends|failure|usecase|component|for|returns|check|when|otherwise|each|repeat|until|return|end|screen|state|prop|event|action|call|with|show|step|flow|route|on|set|run|go|back|job|system_event)\\b"
        },
        {
          "name": "keyword.operator.logi",
          "match": "\\b(and|or|not|is|has|in|with|from|as|to|exists)\\b"
        },
        {
          "name": "keyword.other.logi",
          "match": "\\b(fail|start)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(module)\\s+([a-z_][a-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.logi"
            },
            "2": {
              "name": "entity.name.namespace.logi"
            }
          }
        },
        {
          "match": "\\b(type|failure|widget|screen|flow|component)\\s+([a-z_][a-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.logi"
            },
            "2": {
              "name": "entity.name.type.logi"
            }
          }
        },
        {
          "match": "\\b(usecase|job|system_event)\\s+([a-z_][a-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.logi"
            },
            "2": {
              "name": "entity.name.function.logi"
            }
          }
        },
        {
          "match": "\\b(state|prop)\\s+([a-z_][a-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.logi"
            },
            "2": {
              "name": "variable.other.readwrite.logi"
            }
          }
        },
        {
          "match": "\\b(event|action)\\s+([a-z_][a-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.logi"
            },
            "2": {
              "name": "entity.name.function.logi"
            }
          }
        }
      ]
    },
    "built-in-types": {
      "patterns": [
        {
          "name": "support.type.primitive.logi",
          "match": "\\b(text|number|decimal|boolean|date|datetime|void)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.logi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.logi",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.logi",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logi",
          "match": "(->|:|=|\\?|\\[|\\]|\\||,)"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "name": "meta.embedded.expression.logi",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "name": "variable.other.logi",
              "match": "[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*"
            }
          ]
        }
      ]
    },
    "qualified-names": {
      "patterns": [
        {
          "name": "variable.other.object.property.logi",
          "match": "\\b[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)+\\b"
        }
      ]
    }
  }
}

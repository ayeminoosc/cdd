/**
 * User Entity
 */
data User {
  id: string
  name: string
  email: string
}

/**
 * Todo Entity
 */
data Todo {
  id: string
  title: string
  isCompleted: boolean
  userId: string
}

/**
 * Service to manage Users
 */
service UserService {
  func createUser(user: User): User
  func getUserById(id: string): User?
}

/**
 * Service to manage Todos
 */
service TodoService {
  func getAllTodos(): Todo[]
  func getTodoById(id: string): Todo?
  func createTodo(todo: Todo): Todo
  func updateTodo(id: string, todo: Todo): Todo
  func deleteTodo(id: string): void
}

/**
 * Main Application Entry Point
 */
service TodoBackendApplication {
  func main(args: string[]): void
}
